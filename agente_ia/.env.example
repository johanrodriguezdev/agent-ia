# O.R.I.O.N. — Variables de entorno
# Copia este archivo como .env y completa los valores

# Proveedor LLM principal (deepseek | anthropic | openai | gemini | ollama)
AI_PROVIDER=deepseek

# API Keys (solo las que uses)
DEEPSEEK_API_KEY=sk-tu_deepseek_key_aqui
ANTHROPIC_API_KEY=sk-ant-tu_claude_key_aqui
OPENAI_API_KEY=sk-tu_openai_key_aqui
GEMINI_API_KEY=tu_gemini_key_aqui

# Bots
TELEGRAM_BOT_TOKEN=tu_telegram_token_aqui
DISCORD_BOT_TOKEN=tu_discord_token_aqui
