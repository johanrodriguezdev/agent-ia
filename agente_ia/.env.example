# Credenciales de O.R.I.O.N.
#
# Este archivo NO se sube a git (esta en .gitignore). Es el sitio correcto para las claves:
# config_manager.py lee primero de aqui y solo despues de config.json, asi que lo que
# pongas aca gana y nunca acaba en el repositorio.
#
# Pega tu clave despues del "=", sin comillas y sin espacios alrededor.
# Al terminar, reinicia la aplicacion para que la lea.

# Proveedor activo segun config.json ("ai_provider": "deepseek")
DEEPSEEK_API_KEY=

# Otros proveedores (opcionales)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Canales remotos (opcionales)
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
